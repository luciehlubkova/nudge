generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id               String     @id @default(cuid())
  title            String
  description      String?
  duration         Duration
  categoryId       String
  category         Category   @relation(fields: [categoryId], references: [id])
  deadline         DateTime?
  reminderDateTime DateTime?
  url              String?
  imageUrl         String?
  repeatType       RepeatType @default(none)
  isArchived       Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

enum Duration {
  min5
  min15
  min60
  min90plus
}

enum RepeatType {
  none
  daily
  weekly
  monthly
}
